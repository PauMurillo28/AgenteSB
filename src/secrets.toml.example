# Copie este archivo como secrets.toml (NO lo suba a GitHub) y complete los valores.
GEMINI_API_KEY = "su_clave_de_google_ai_studio"
ADMIN_KEY = "una_clave_para_ver_el_registro"
# Opcional: modelos en orden de preferencia (si el primero falla por límite, usa el siguiente)
# MODELS = "gemini-2.5-flash,gemini-2.5-flash-lite"

# Opcional: registro en Google Sheets (si no se configura, se guarda en un CSV local)
# SHEET_ID = "id_de_la_hoja"
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# token_uri = "https://oauth2.googleapis.com/token"
